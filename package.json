{
  "name": "kiro-repo-visualizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n vite,server -c blue,green \"vite\" \"npm run dev:server\"",
    "dev:server": "npm run server:build && nodemon --watch src/server --watch src/config --watch src/types --ext ts --exec \"npm run server:build && node dist/server/server/index.js\"",
    "build": "tsc -p tsconfig.json && vite build && npm run server:build",
    "server:build": "tsc -p tsconfig.server.json && node -e \"require('fs').writeFileSync('dist/server/package.json', '{\\\"type\\\":\\\"commonjs\\\"}')\"",
    "server": "npm run server:build && node dist/server/server/index.js",
    "test": "vitest run --coverage",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "6.1.0",
    "@dnd-kit/sortable": "8.0.0",
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "canvas": "^3.1.0",
    "concurrently": "8.2.2",
    "cors": "2.8.5",
    "express": "4.19.2",
    "fluent-ffmpeg": "2.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/fluent-ffmpeg": "2.1.25",
    "@types/node": "20.14.9",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/supertest": "6.0.2",
    "@vitejs/plugin-react": "4.3.1",
    "@vitest/coverage-v8": "1.6.0",
    "nodemon": "3.1.4",
    "supertest": "7.0.0",
    "ts-node": "10.9.2",
    "typescript": "5.5.3",
    "vite": "5.3.3",
    "vitest": "1.6.0"
  },
  "allowScripts": {
    "canvas@3.1.0": true,
    "esbuild@0.21.5": true,
    "@ffmpeg-installer/linux-x64@4.1.0": true
  }
}
